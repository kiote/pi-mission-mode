{
  "name": "pi-mission-mode",
  "version": "0.1.0",
  "description": "Experimental goal-driven missions for Pi: verified continuation, external-event waiting, progress digests, and explicit recovery.",
  "type": "module",
  "license": "MIT",
  "author": "kiote",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiote/pi-mission-mode.git"
  },
  "homepage": "https://github.com/kiote/pi-mission-mode#readme",
  "bugs": {
    "url": "https://github.com/kiote/pi-mission-mode/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "agents",
    "missions",
    "autonomy"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm test",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "22.20.5",
    "jiti": "2.6.1",
    "prettier": "3.6.2",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
